export ISAAC_SIM_IMAGE=nvcr.io/nvidia/isaac-sim:6.0.1
export ISAAC_SIM_DATA=$HOME/docker/droid2sim-isaac
export ISAACSIM_HUB_CACHE_PATH=$HOME/.cache/ov/hub
